load("@rules_python//python:defs.bzl", "py_binary", "py_test")

# Apache-2.0 + SPDX file-header enforcement (replaces sbt-header). Each module
# exposes its Scala sources as a `license_srcs` filegroup (globs don't cross
# package boundaries), which this test reads via $(rootpaths ...). py_test (like
# //tools/deps) resolves the hermetic Python interpreter for RBE.
_LICENSE_SRCS = [
    "//modules/bagit:license_srcs",
    "//modules/ingest:license_srcs",
    "//modules/jwt:license_srcs",
    "//modules/shacl-validator:license_srcs",
    "//modules/test-e2e:license_srcs",
    "//modules/test-ingest-integration:license_srcs",
    "//modules/test-it:license_srcs",
    "//modules/test-runner:license_srcs",
    "//modules/testkit:license_srcs",
    "//modules/webapi:license_srcs",
]

py_test(
    name = "spdx_header_check",
    srcs = ["check_spdx_header.py"],
    args = ["$(rootpaths %s)" % t for t in _LICENSE_SRCS],
    data = _LICENSE_SRCS,
    main = "check_spdx_header.py",
)

# `bazel run //tools/license:fix` (or `just header-fix`) — insert the header
# into any modules/**/*.scala missing it, in place.
py_binary(
    name = "fix",
    srcs = ["fix_spdx_header.py"],
    main = "fix_spdx_header.py",
)
