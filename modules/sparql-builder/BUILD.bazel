load("//tools/scalafmt:defs.bzl", "scala_junit_test", "scala_library")

# Safe, composable SPARQL query building: `sparql"..."` interpolator + Fragment monoid +
# validated typed values (Iri, Variable, Literal). Pure leaf module with no main-source
# dependencies; RDF4J appears only in tests, as the escaping-parity oracle.
# See docs/sparql-builder-approaches/ for the design decision.
scala_library(
    name = "sparql-builder",
    srcs = glob(["src/main/scala/**/*.scala"]),
    format = True,
    visibility = ["//visibility:public"],
)

scala_junit_test(
    name = "test",
    srcs = glob(["src/test/scala/**/*.scala"]),
    format = True,
    # Discovery is by class-name suffix; a missed suffix silently skips specs.
    suffixes = ["Spec", "IT", "Test"],
    deps = [
        ":sparql-builder",
        "//modules/test-runner",
        "@maven//:dev_zio_zio_3",
        "@maven//:dev_zio_zio_test_3",
        "@maven//:org_eclipse_rdf4j_rdf4j_sparqlbuilder",
    ],
)

# Scala sources for the Apache-2.0 SPDX header check (//tools/license). Globs
# don't cross package boundaries, so each module exposes its own sources.
filegroup(
    name = "license_srcs",
    srcs = glob(["src/**/*.scala"]),
    visibility = ["//tools:__subpackages__"],
)
