load("//tools/scalafmt:defs.bzl", "scala_junit_test", "scala_library")

# Memory specs run only in :memory_test, under its small heap.
_MEMORY_SPEC_PATTERN = "src/test/scala/**/*MemorySpec.scala"

# SHACL validator. Pure leaf module.
scala_library(
    name = "shacl-validator",
    format = True,
    srcs = glob(["src/main/scala/**/*.scala"]),
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:dev_zio_zio_3",
        # topbraid-shacl's API surface returns Apache Jena types; ShaclValidator uses
        # jena-core (rdf.model, graph) and jena-arq (riot, sparql) directly.
        "@maven//:org_apache_jena_jena_arq",
        "@maven//:org_apache_jena_jena_core",
        "@maven//:org_topbraid_shacl",
    ],
)

scala_junit_test(
    name = "test",
    format = True,
    srcs = glob(
        ["src/test/scala/**/*.scala"],
        exclude = [_MEMORY_SPEC_PATTERN],
    ),
    # Discovery is by class-name suffix; a missed suffix silently skips specs.
    suffixes = ["Spec", "IT", "Test"],
    # test-onto-shapes.ttl fixture read by ShaclValidatorSpec.
    resources = glob(["src/test/resources/**"]),
    deps = [
        ":shacl-validator",
        "//modules/test-runner",
        "@maven//:dev_zio_zio_3",
        "@maven//:dev_zio_zio_test_3",
        "@maven//:org_slf4j_slf4j_simple",
    ],
)

# Runs under a small heap so a validation model that grows with inference fails
# with OutOfMemoryError (JVM exit) instead of passing.
scala_junit_test(
    name = "memory_test",
    size = "medium",
    format = True,
    srcs = glob([_MEMORY_SPEC_PATTERN]),
    jvm_flags = [
        "-Xmx256m",
        "-XX:+ExitOnOutOfMemoryError",
    ],
    suffixes = ["Spec", "IT", "Test"],
    deps = [
        ":shacl-validator",
        "//modules/test-runner",
        "@maven//:dev_zio_zio_3",
        "@maven//:dev_zio_zio_test_3",
        "@maven//:org_slf4j_slf4j_simple",
    ],
)

# Scala sources for the Apache-2.0 SPDX header check (//tools/license). Globs
# don't cross package boundaries, so each module exposes its own sources.
filegroup(
    name = "license_srcs",
    srcs = glob(["src/**/*.scala"]),
    visibility = ["//tools:__subpackages__"],
)
