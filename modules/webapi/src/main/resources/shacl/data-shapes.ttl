# Placeholder IRIs (urn:placeholder:*) are replaced at runtime with actual values
# by ProjectMigrationImportShaclValidator before validation.
# - urn:placeholder:projectIri  →  the IRI of the project being imported

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix dash:       <http://datashapes.org/dash#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix knora-base:  <http://www.knora.org/ontology/knora-base#> .
@prefix knora-admin: <http://www.knora.org/ontology/knora-admin#> .

# Validates every instance of a knora-base:Resource subclass.
# With RDFS inference, sh:targetClass matches instances of all subclasses.
knora-base:ResourceShape
  a sh:NodeShape ;
  sh:targetClass knora-base:Resource ;
  sh:property [
    a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Resource instance must have at least one rdfs:label" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:isDeleted ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
    sh:message "Resource instance must have knora-base:isDeleted of type xsd:boolean" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:attachedToUser ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "Resource instance must have knora-base:attachedToUser IRI" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:attachedToProject ;
    sh:hasValue <urn:placeholder:projectIri> ;
    sh:maxCount 1 ;
    sh:maxCount 1 ;
    sh:message "Resource instance must have exactly one knora-base:attachedToProject equal to <urn:placeholder:projectIri>" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasPermissions ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "Resource instance must have knora-base:hasPermissions of type xsd:string" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:creationDate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
    sh:message "Resource instance must have knora-base:creationDate of type xsd:dateTime" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasStandoffLinkTo ;
    sh:class knora-base:Resource ;
    sh:message "The target of knora-base:hasStandoffLinkTo must be a resource that is present in the data graph"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasStandoffLinkToValue ;
    sh:class knora-base:LinkValue ;
    sh:message "The target of knora-base:hasStandoffLinkTo must be a knora-base:LinkValue"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasStandoffLinkTo ;
    dash:coExistsWith knora-base:hasStandoffLinkToValue ;
    sh:message "A knora-base:hasStandoffLinkTo always requires a knora-base:hasStandoffLinkToValue"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasResourceAuthorship ;
    sh:minCount 0 ;
    sh:datatype xsd:string ;
    sh:message "Resource instance must have knora-base:hasResourceAuthorship of type xsd:string" ;
  ] .

# Validates every instance of a knora-base:Value subclass.
# With RDFS inference, sh:targetClass matches instances of all subclasses.
knora-base:ValueShape
  a sh:NodeShape ;
  sh:targetClass knora-base:Value ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:valueCreationDate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
    sh:message "Value instance must have knora-base:valueCreationDate of type xsd:dateTime" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:attachedToUser ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Value instance must have knora-base:attachedToUser" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasPermissions ;
    sh:maxCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "Value instance must have at most one knora-base:hasPermissions of type xsd:string" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:isDeleted ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
    sh:message "Value instance must have knora-base:isDeleted of type xsd:boolean" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:valueHasOrder ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:message "Value instance must have one knora-base:valueHasOrder of type xsd:integer" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:valueHasComment ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "Value instance must have at most one knora-base:valueHasComment of type xsd:string" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:valueHasString ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "Value instance must have one knora-base:valueHasString of type xsd:string" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:valueHasUUID ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "Value instance must have at most one knora-base:valueHasUUID of type xsd:string" ;
  ] .

# Validates every instance of knora-base:LinkValue.
# LinkValue is a subclass of Value, so ValueShape constraints also apply.
knora-base:LinkValueShape
  a sh:NodeShape ;
  sh:targetClass knora-base:LinkValue ;
  sh:property [
    a sh:PropertyShape ;
    sh:path rdf:subject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class knora-base:Resource ;
    sh:message "LinkValue instance must have rdf:subject of type knora-base:Resource" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path rdf:predicate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "LinkValue instance must have rdf:predicate of type sh:IRI" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path rdf:object ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class knora-base:Resource ;
    sh:message "LinkValue instance must have rdf:object of type knora-base:Resource" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:valueHasRefCount ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:message "LinkValue instance must have knora-base:valueHasRefCount of type xsd:integer" ;
  ] .

# Validates that every knora-base:attachedToUser value (on resources and values)
# references a node of type knora-admin:User. Since admin.nq is loaded into the
# unified model, the knora-admin:User nodes are present and SHACL with RDFS
# inference can verify this.
knora-base:AttachedToUserExistsShape
  a sh:NodeShape ;
  sh:targetSubjectsOf knora-base:attachedToUser ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:attachedToUser ;
    sh:class knora-admin:User ;
    sh:message "knora-base:attachedToUser must reference a knora-admin:User instance" ;
  ] .

# Rejects imports whose data graph attaches resources or values to the built-in
# SystemUser or AnonymousUser. These IRIs exist on every target instance and
# pre-migration cleanup is required to rebind such data to project-scoped users.
# System standoff-link LinkValues are exempt: both the data-import transformer
# (OntologyTransformer.emitStandoffLinkValue) and the v2 create path attach them to SystemUser by
# design. They are identified by rdf:predicate knora-base:hasStandoffLinkTo.
knora-base:AttachedToUserNotBuiltInShape
  a sh:NodeShape ;
  sh:targetSubjectsOf knora-base:attachedToUser ;
  sh:or (
    [
      sh:path rdf:predicate ;
      sh:hasValue knora-base:hasStandoffLinkTo ;
    ]
    [
      sh:path knora-base:attachedToUser ;
      sh:not [ sh:in ( knora-admin:SystemUser knora-admin:AnonymousUser ) ] ;
      sh:message "knora-base:attachedToUser must not reference the built-in SystemUser or AnonymousUser" ;
    ]
  ) .
