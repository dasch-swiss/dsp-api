knora-base:AttachedToUserExists-Shape
  a sh:NodeShape ;
  sh:targetSubjectsOf knora-base:attachedToUser ;
  sh:description "Checks that every knora-base:attachedToUser value points to a real knora-admin:User. sh:targetSubjectsOf selects every node that has an owner. The admin data loads into the same model, so RDFS inference can confirm the user exists." ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:attachedToUser ;
    sh:class knora-admin:User ;
    sh:message "knora-base:attachedToUser must reference a knora-admin:User instance" ;
  ] .

knora-base:AttachedToUserNotBuiltIn-Shape
  a sh:NodeShape ;
  sh:targetSubjectsOf knora-base:attachedToUser ;
  sh:description "Rejects data that attaches a resource or value to the built-in SystemUser or AnonymousUser. Rebind such data to project users before migration. System standoff-link LinkValues are exempt, because the import transformer and the v2 create path attach them to SystemUser by design. The exemption keys on a LinkValue that carries rdf:predicate knora-base:hasStandoffLinkTo." ;
  sh:or (
    # The exempted node must be a LinkValue that carries the standoff predicate and attaches to SystemUser.
    # A LinkValue on any other built-in user (for example AnonymousUser) is not exempt.
    # The same guard is duplicated in bulk-import-shapes.ttl Value-Shape — keep both in sync.
    [
      sh:class knora-base:LinkValue ;
      sh:property [ sh:path rdf:predicate ; sh:hasValue knora-base:hasStandoffLinkTo ] ;
      sh:property [ sh:path knora-base:attachedToUser ; sh:hasValue knora-admin:SystemUser ] ;
    ]
    [
      sh:path knora-base:attachedToUser ;
      sh:not [ sh:in ( knora-admin:SystemUser knora-admin:AnonymousUser ) ] ;
      sh:message "knora-base:attachedToUser must not reference the built-in SystemUser or AnonymousUser" ;
    ]
  ) .
