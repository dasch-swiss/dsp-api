  a sh:NodeShape ;
  sh:targetClass knora-base:DDDRepresentation ;
  sh:property [
    sh:path knora-base:hasDDDFileValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class knora-base:DDDFileValue ;
    sh:message "DDDRepresentation instance must have one knora-base:hasDDDFileValue of type knora-base:DDDFileValue"
  ] .

knora-base:AudioRepresentation-Shape
  a sh:NodeShape ;
