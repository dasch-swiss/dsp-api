  sh:targetClass knora-base:StillImageVectorFileValue .

knora-base:TextFileValue-Shape
  a sh:NodeShape ;
  sh:targetClass knora-base:TextFileValue .

# Validates that every knora-base:attachedToUser value (on resources and values)
# references a node of type knora-admin:User. Since admin.nq is loaded into the
# unified model, the knora-admin:User nodes are present and SHACL with RDFS
# inference can verify this.
knora-base:AttachedToUserExists-Shape
  a sh:NodeShape ;
  sh:targetSubjectsOf knora-base:attachedToUser ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:attachedToUser ;
    sh:class knora-admin:User ;
    sh:message "knora-base:attachedToUser must reference a knora-admin:User instance" ;
  ] .

# Rejects imports whose data graph attaches resources or values to the built-in
# SystemUser or AnonymousUser. These IRIs exist on every target instance and
# pre-migration cleanup is required to rebind such data to project-scoped users.
# System standoff-link LinkValues are exempt: both the data-import transformer
# (OntologyTransformer.emitStandoffLinkValue) and the v2 create path attach them to SystemUser by
# design. They are identified by rdf:predicate knora-base:hasStandoffLinkTo.
knora-base:AttachedToUserNotBuiltIn-Shape
  a sh:NodeShape ;
  sh:targetSubjectsOf knora-base:attachedToUser ;
  sh:or (
    [
      sh:path rdf:predicate ;
      sh:hasValue knora-base:hasStandoffLinkTo ;
    ]
    [
      sh:path knora-base:attachedToUser ;
      sh:not [ sh:in ( knora-admin:SystemUser knora-admin:AnonymousUser ) ] ;
      sh:message "knora-base:attachedToUser must not reference the built-in SystemUser or AnonymousUser" ;
    ]
  ) .
