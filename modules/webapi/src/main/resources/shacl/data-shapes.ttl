# FileValues

knora-base:FileValue-Shape
  a sh:NodeShape ;
  sh:targetClass knora-base:FileValue ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:internalFilename ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "FileValue instance must have one knora-base:internalFilename of type xsd:string"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:internalMimeType ; # TODO: find out if there is sh:in
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "FileValue instance must have one knora-base:internalMimeType of type xsd:string"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:originalMimeType ; # TODO: find out if there is sh:in
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "FileValue instance may have at most one knora-base:originalMimeType of type xsd:string"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:originalFilename ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "FileValue instance may have at most one knora-base:originalFilename of type xsd:string"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasCopyrightHolder ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "FileValue instance may have at most one knora-base:hasCopyrightHolder of type xsd:string"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasAuthorship ;
    sh:datatype xsd:string ;
    sh:message "FileValue instance can have any number of knora-base:hasAuthorship of type xsd:string"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasLicense ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "FileValue instance may have at most one knora-base:hasLicense as an IRI"
  ] .

