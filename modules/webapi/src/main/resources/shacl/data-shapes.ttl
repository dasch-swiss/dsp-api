# Placeholder IRIs (urn:placeholder:*) are replaced at runtime with actual values
# by ProjectMigrationImportShaclValidator before validation.
# - urn:placeholder:projectIri  →  the IRI of the project being imported

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix dash:       <http://datashapes.org/dash#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix knora-base:  <http://www.knora.org/ontology/knora-base#> .
@prefix knora-admin: <http://www.knora.org/ontology/knora-admin#> .

knora-base:Resource-Shape
  a sh:NodeShape ;
  sh:targetClass knora-base:Resource ;
  sh:description "Validates every knora-base:Resource subclass instance. RDFS inference makes sh:targetClass match subclass instances. This shape checks the base metadata that every resource shares, and the standoff-link reification pair." ;
  sh:property [
    a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Resource instance must have at least one rdfs:label" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:isDeleted ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
    sh:message "Resource instance must have knora-base:isDeleted of type xsd:boolean" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:attachedToUser ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "Resource instance must have knora-base:attachedToUser of type IRI" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:attachedToProject ;
    sh:hasValue <urn:placeholder:projectIri> ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Resource instance must have exactly one knora-base:attachedToProject equal to <urn:placeholder:projectIri>" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasPermissions ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "Resource instance must have knora-base:hasPermissions of type xsd:string" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:creationDate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
    sh:message "Resource instance must have knora-base:creationDate of type xsd:dateTime" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasResourceAuthorship ;
    sh:datatype xsd:string ;
    sh:message "Resource instance must have knora-base:hasResourceAuthorship of type xsd:string" ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasStandoffLinkTo ;
    sh:class knora-base:Resource ;
    sh:message "The target of knora-base:hasStandoffLinkTo must be a resource that is present in the data graph"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasStandoffLinkToValue ;
    sh:class knora-base:LinkValue ;
    sh:message "The target of knora-base:hasStandoffLinkTo must be a knora-base:LinkValue"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasStandoffLinkTo ;
    sh:description "A standoff link inside formatted text points from this resource to a target resource through knora-base:hasStandoffLinkTo. The matching knora-base:hasStandoffLinkToValue reifies that link. Both must appear together, so the link and its reified statement never fall out of sync." ;
    dash:coExistsWith knora-base:hasStandoffLinkToValue ;
    sh:message "A knora-base:hasStandoffLinkTo always requires a knora-base:hasStandoffLinkToValue"
  ] .

knora-base:Region-Shape
  a sh:NodeShape ;
  sh:targetClass knora-base:Region ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasColor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class knora-base:ColorValue ;
    sh:message "Instance of Region must have one knora-base:hasColor of type knora-base:ColorValue"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:isRegionOf ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class knora-base:Representation ;
    sh:message "Instance of Region must have one knora-base:isRegionOf of type knora-base:Representation"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:isRegionOfValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class knora-base:LinkValue ;
    sh:message "Instance of Region must have one knora-base:isRegionOfValue of type knora-base:LinkValue"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasGeometry ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class knora-base:GeomValue ;
    sh:message "Instance of Region must have one knora-base:hasGeometry of type knora-base:GeomValue"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasComment ;
    sh:class knora-base:TextValue ;
    sh:message "Instance of Region may have any number of knora-base:hasComment of type knora-base:TextValue"
  ] .

knora-base:LinkObj-Shape
  a sh:NodeShape ;
  sh:targetClass knora-base:LinkObj ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasLinkTo ;
    sh:minCount 1 ;
    sh:class knora-base:Resource ;
    sh:message "Instance of LinkObj requires at least one knora-base:hasLinkTo to a Resource that exists in this graph"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasLinkToValue ;
    sh:minCount 1 ;
    sh:class knora-base:LinkValue ;
    sh:message "Instance of LinkObj requires at least one knora-base:hasLinkToValue of type knora-base:LinkValue"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasComment ;
    sh:class knora-base:TextValue ;
    sh:message "Instance of LinkObj may have any number of knora-base:hasComment of type knora-base:TextValue"
  ] .

knora-base:Annotation-Shape
  a sh:NodeShape ;
  sh:targetClass knora-base:Annotation ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasComment ;
    sh:minCount 1 ;
    sh:class knora-base:TextValue ;
    sh:message "Annotation instance must have at least one knora-base:hasComment of type knora-base:TextValue"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:isAnnotationOf ;
    sh:minCount 1 ;
    sh:class knora-base:Resource ;
    sh:message "Annotation instance must have at least one knora-base:isAnnotationOf to a Resource that exists in this graph"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:isAnnotationOfValue ;
    sh:minCount 1 ;
    sh:class knora-base:LinkValue ;
    sh:message "Annotation instance must have at least one knora-base:isAnnotationOfValue of type knora-base:LinkValue"
  ] .


# Shapes for Segment

knora-base:Segment-Shape
  a sh:NodeShape ;
  sh:targetClass knora-base:Segment ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:hasComment ;
    sh:class knora-base:TextValue ;
    sh:message "Instance of Segment may have any number of knora-base:hasComment of type knora-base:TextValue"
  ] ;
  sh:property [
    sh:path knora-base:hasSegmentBounds ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class knora-base:IntervalValue ;
    sh:message "Segment instance must have one knora-base:hasSegmentBounds of type knora-base:IntervalValue"
  ] ;
  sh:property [
    sh:path knora-base:hasTitle ;
    sh:maxCount 1 ;
    sh:class knora-base:TextValue ;
    sh:message "Segment instance may have one knora-base:hasTitle of type knora-base:TextValue"
  ] ;
  sh:property [
    sh:path knora-base:hasDescription ;
    sh:class knora-base:TextValue ;
    sh:message "Segment instance may have any number of knora-base:hasDescription of type knora-base:TextValue"
  ] ;
  sh:property [
    sh:path knora-base:hasKeyword ;
    sh:class knora-base:TextValue ;
    sh:message "Segment instance may have any number of knora-base:hasKeyword of type knora-base:TextValue"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:relatesTo ;
    sh:class knora-base:Resource ;
    sh:message "Segment instance may have any number of knora-base:relatesTo to a Resource that exists in this graph"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:relatesToValue ;
    sh:class knora-base:LinkValue ;
    sh:message "Segment instance may have any number of knora-base:relatesToValue of type knora-base:LinkValue"
  ] .

knora-base:AudioSegment-Shape
  a sh:NodeShape ;
  sh:targetClass knora-base:AudioSegment ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:isAudioSegmentOf ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class knora-base:AudioRepresentation ;
    sh:message "Instance of AudioSegment requires one knora-base:isAudioSegmentOf to a knora-base:AudioRepresentation that exists in this graph"
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path knora-base:isAudioSegmentOfValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class knora-base:LinkValue ;
    sh:message "Instance of AudioSegment requires ne knora-base:isAudioSegmentOfValue of type knora-base:LinkValue"
  ] .

knora-base:VideoSegment-Shape
  a sh:NodeShape ;
  sh:targetClass knora-base:VideoSegment ;
  sh:property [
      a sh:PropertyShape ;
      sh:path knora-base:isVideoSegmentOf ;
      sh:minCount 1 ;
      sh:maxCount 1 ;
      sh:class knora-base:MovingImageRepresentation ;
      sh:message "Instance of VideoSegment requires one knora-base:isVideoSegmentOf to a knora-base:MovingImageRepresentation that exists in this graph"
    ] ;
  sh:property [
      a sh:PropertyShape ;
      sh:path knora-base:isVideoSegmentOfValue ;
      sh:minCount 1 ;
      sh:maxCount 1 ;
      sh:class knora-base:LinkValue ;
      sh:message "Instance of VideoSegment requires one knora-base:isVideoSegmentOfValue of type knora-base:LinkValue"
    ] .

# Shapes for sub-classes of knora-base:Representation

