        <http://www.knora.org/ontology/knora-base#hasPermissions>
                "ProjectResourceCreateAllPermission" .

<http://rdfh.ch/permissions/9999/vt4coLVBQjuKFUjGSyj4AQ>
        rdf:type                knora-admin:DefaultObjectAccessPermission;
        knora-admin:forGroup    knora-admin:ProjectMember;
        knora-admin:forProject  <http://rdfh.ch/projects/Rt2eOA19Q16vMYb_cIkw2g>;
        <http://www.knora.org/ontology/knora-base#hasPermissions>
                "D knora-admin:ProjectMember|CR knora-admin:ProjectAdmin|V knora-admin:KnownUser,knora-admin:UnknownUser" .

