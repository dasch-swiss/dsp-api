        knora-admin:forProject   <http://rdfh.ch/projects/Rt2eOA19Q16vMYb_cIkw2g>;
        knora-admin:forProperty  <http://www.knora.org/ontology/9999/onto#testPrivateProp>;
        <http://www.knora.org/ontology/knora-base#hasPermissions>
                "D knora-admin:ProjectMember|CR knora-admin:ProjectAdmin" .

<http://rdfh.ch/permissions/9999/ttD2pz9eRmmSB4Z4_AKtzA>
        rdf:type                      knora-admin:DefaultObjectAccessPermission;
        knora-admin:forProject        <http://rdfh.ch/projects/Rt2eOA19Q16vMYb_cIkw2g>;
        knora-admin:forResourceClass  <http://www.knora.org/ontology/9999/onto#PrivateResource>;
        <http://www.knora.org/ontology/knora-base#hasPermissions>
