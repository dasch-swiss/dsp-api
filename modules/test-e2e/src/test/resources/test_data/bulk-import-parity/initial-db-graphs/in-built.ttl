<http://www.knora.org/ontology/9999/in-built#TestStillImageRepresentationWithSeqnum>
        rdf:type  <http://www.w3.org/2002/07/owl#Class>;
        <http://www.w3.org/2000/01/rdf-schema#label>
                "StillImageRepresentation with knora-api:seqnum"@en;
