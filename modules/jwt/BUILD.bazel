load("//tools/scalafmt:defs.bzl", "scala_junit_test", "scala_library")

# Minimal JWT library: HS256 encode/decode and Ed25519 (EdDSA) verification. Pure leaf module.
scala_library(
    name = "jwt",
    srcs = glob(["src/main/scala/**/*.scala"]),
    format = True,
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:dev_zio_zio_3",
        "@maven//:dev_zio_zio_json_3",
        # zio-json's public API references zio.stream.{ZStream,ZPipeline}, so the
        # compile classpath needs zio-streams even though jwt uses none directly.
        "@maven//:dev_zio_zio_streams_3",
    ],
)

# Test-only Ed25519 signer, shared by the jwt, webapi and e2e tests. Main code never signs.
scala_library(
    name = "testkit",
    testonly = True,
    srcs = glob(["src/testkit/scala/**/*.scala"]),
    format = True,
    visibility = ["//visibility:public"],
    deps = [
        ":jwt",
        "@maven//:dev_zio_zio_3",
        "@maven//:dev_zio_zio_json_3",
        "@maven//:dev_zio_zio_streams_3",
    ],
)

scala_junit_test(
    name = "test",
    srcs = glob(["src/test/scala/**/*.scala"]),
    format = True,
    # Discovery is by class-name suffix; a missed suffix silently skips specs.
    suffixes = ["Spec", "IT", "Test"],
    deps = [
        ":jwt",
        ":testkit",
        "//modules/test-runner",
        "@maven//:dev_zio_zio_3",
        "@maven//:dev_zio_zio_json_3",
        "@maven//:dev_zio_zio_streams_3",
        "@maven//:dev_zio_zio_test_3",
    ],
)

# Scala sources for the Apache-2.0 SPDX header check (//tools/license). Globs
# don't cross package boundaries, so each module exposes its own sources.
filegroup(
    name = "license_srcs",
    srcs = glob(["src/**/*.scala"]),
    visibility = ["//tools:__subpackages__"],
)
