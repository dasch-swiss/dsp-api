SELECT DISTINCT ?mainRes (GROUP_CONCAT(DISTINCT(IF(BOUND(?li), STR(?li), "")); SEPARATOR='') AS ?li__Concat)
WHERE {
<http://rdfh.ch/lists/0812/JS06AyiJR-qRce2laMtF1w> <http://www.knora.org/ontology/knora-base#hasSubListNode>* ?lnv .
?li <http://www.knora.org/ontology/knora-base#valueHasListNode> ?lnv .
?mainRes <http://www.knora.org/ontology/0812/ekws#hasMedium> ?li .
?mainRes <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.knora.org/ontology/0812/ekws#Object> .
FILTER NOT EXISTS {
 ?mainRes <http://www.knora.org/ontology/knora-base#isDeleted> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .

}
FILTER NOT EXISTS {
 ?li <http://www.knora.org/ontology/knora-base#isDeleted> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .

}
}
GROUP BY ?mainRes
ORDER BY ASC(?mainRes)
LIMIT 25
