      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "INGEST JVM Memory",
          "description": "dsp-ingest JVM heap: used against max.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
